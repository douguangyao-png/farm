# 演示服务器模式：部署到 http://121.40.221.126/farm/steward/，接口走同源 /farm-api
# 构建：pnpm build:h5:demo
NODE_ENV = 'production'
VITE_DELETE_CONSOLE = false
VITE_SHOW_SOURCEMAP = false

VITE_APP_TITLE = '认养农场 · 管家'
VITE_APP_PORT = 9000

VITE_SERVER_BASEURL = '/farm-api/admin-api'
VITE_UPLOAD_BASEURL = '/farm-api/upload'
VITE_APP_PROXY_ENABLE = false

VITE_APP_TENANT_ENABLE = true
VITE_APP_CAPTCHA_ENABLE = false
# mock-server 不做接口加密
VITE_APP_API_ENCRYPT_ENABLE = false
VITE_APP_DEFAULT_LOGIN_TENANT_ID = 2
VITE_APP_DEFAULT_LOGIN_USERNAME = zhangguanjia
VITE_APP_DEFAULT_LOGIN_PASSWORD = demo123

# 显示「演示数据」角标（R-7）
VITE_MOCK_BADGE = true

# 子路径部署
VITE_APP_PUBLIC_BASE = /farm/steward/
