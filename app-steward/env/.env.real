# 真后端模式：部署到 https://121.40.221.126/farm-real/steward/，接口走同源 /farm-real-api
# 构建：pnpm build:h5:real
NODE_ENV = 'production'
VITE_DELETE_CONSOLE = true
VITE_SHOW_SOURCEMAP = false

VITE_APP_TITLE = '认养农场 · 管家'
VITE_APP_PORT = 9000

VITE_SERVER_BASEURL = '/farm-real-api/admin-api'
VITE_UPLOAD_BASEURL = '/farm-real-api/upload'
VITE_APP_PROXY_ENABLE = false

VITE_APP_TENANT_ENABLE = true
VITE_APP_CAPTCHA_ENABLE = false
VITE_APP_API_ENCRYPT_ENABLE = false
VITE_APP_DEFAULT_LOGIN_TENANT_ID = 2
VITE_APP_DEFAULT_LOGIN_USERNAME = zhangguanjia
VITE_APP_DEFAULT_LOGIN_PASSWORD = demo123

# 真后端：不带「演示数据」角标
VITE_MOCK_BADGE = false

# 子路径部署
VITE_APP_PUBLIC_BASE = /farm-real/steward/

# 登录页不选租户，按用户名确定租户（用户名全平台唯一）
VITE_APP_LOGIN_BY_USERNAME = true
