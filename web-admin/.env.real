# 真后端模式：接口走 nginx 的 /farm-real-api/ 转发到 48080 的芋道 + farm 模块；和 mock 版（.env.demo，/farm/）并存。
# 构建：pnpm build:real，产物 dist-real，部署到服务器 /opt/farmer-saas/web/admin-real/
NODE_ENV=production

VITE_DEV=false
VITE_APP_TITLE=认养农场 SaaS
VITE_PORT=8080
VITE_OPEN=false

VITE_BASE_URL='/farm-real-api'
VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin-api

VITE_APP_API_ENCRYPT_ENABLE=false
VITE_APP_CAPTCHA_ENABLE=false
VITE_APP_DOCALERT_ENABLE=false
VITE_APP_BAIDU_CODE=

# 登录页只填用户名和密码，按用户名找租户
VITE_APP_LOGIN_BY_USERNAME=true

# 真后端：不带演示角标
VITE_MOCK_BADGE=false
# 预览期保留登录页的演示账号快捷切换（只是填账号密码，不是 mock）；正式交付前改成 false
VITE_DEMO_ACCOUNTS=true

VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false
VITE_COMPRESS=none
VITE_BASE_PATH=/farm-real/
VITE_OUT_DIR=dist-real

VITE_MALL_H5_DOMAIN='http://121.40.221.126/farm/m'
VITE_GOVIEW_URL='http://127.0.0.1:3000'
