# 演示服务器模式：部署到 http://121.40.221.126/farm/，接口走同源 /farm-api（nginx 反代到 mock-server）
# 构建：pnpm build:demo（产物在 dist-demo）
NODE_ENV=production

VITE_DEV=false

VITE_APP_TITLE=认养农场 SaaS

VITE_PORT=8080
VITE_OPEN=false

# mock-server 地址
VITE_BASE_URL='/farm-api'
VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin-api

# mock-server 不做接口加密和验证码
VITE_APP_API_ENCRYPT_ENABLE=false
VITE_APP_CAPTCHA_ENABLE=false
VITE_APP_DOCALERT_ENABLE=false
VITE_APP_BAIDU_CODE=

# 登录页默认填好演示账号（经营者）
# 登录页不选租户，按用户名确定租户（用户名全平台唯一）
VITE_APP_LOGIN_BY_USERNAME=true
VITE_APP_DEFAULT_LOGIN_TENANT=青山农场
VITE_APP_DEFAULT_LOGIN_USERNAME=qingshan
VITE_APP_DEFAULT_LOGIN_PASSWORD=demo123

# 页面右上角显示「演示数据」角标（R-7）
VITE_MOCK_BADGE=true

VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=false
VITE_COMPRESS=none
VITE_BASE_PATH=/farm/
VITE_OUT_DIR=dist-demo
VITE_MALL_H5_DOMAIN='http://121.40.221.126/farm/m'
VITE_GOVIEW_URL='http://127.0.0.1:3000'
