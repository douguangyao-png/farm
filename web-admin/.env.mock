# 演示（mock）模式：接口全部发到 mock-server，不连真后端
# 启动：pnpm dev:mock    构建：pnpm build:mock（产物在 dist-mock）
# 真后端请用原有的 .env.prod / pnpm build:prod，产物里不会带 mock 地址和演示角标
NODE_ENV=development

VITE_DEV=true

VITE_APP_TITLE=认养农场 SaaS

VITE_PORT=8080
VITE_OPEN=false

# mock-server 地址
VITE_BASE_URL='http://localhost:48090'
VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin-api

# mock-server 不做接口加密和验证码
VITE_APP_API_ENCRYPT_ENABLE=false
VITE_APP_CAPTCHA_ENABLE=false
VITE_APP_DOCALERT_ENABLE=false
VITE_APP_BAIDU_CODE=

# 登录页默认填好演示账号（经营者）
VITE_APP_DEFAULT_LOGIN_TENANT=青山农场
VITE_APP_DEFAULT_LOGIN_USERNAME=qingshan
VITE_APP_DEFAULT_LOGIN_PASSWORD=demo123

# 页面右上角显示「演示数据」角标（R-7）
VITE_MOCK_BADGE=true

VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=false
VITE_COMPRESS=none
VITE_BASE_PATH=/
VITE_OUT_DIR=dist-mock
VITE_MALL_H5_DOMAIN='http://localhost:3000'
VITE_GOVIEW_URL='http://127.0.0.1:3000'
