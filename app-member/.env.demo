# 演示服务器模式：部署到 http://121.40.221.126/farm/m/，接口走同源 /farm-api（nginx 反代到 mock-server）
# 构建：npm run build:h5:demo（子路径由 scripts/uni.cjs 设置）
SHOPRO_DEV_BASE_URL=/farm-api
SHOPRO_BASE_URL=/farm-api
SHOPRO_TRIAL_BASE_URL=/farm-api
SHOPRO_STATIC_URL=/farm-api/static
SHOPRO_H5_URL=http://121.40.221.126/farm/m
SHOPRO_TENANT_ID=2
SHOPRO_MOCK_BADGE=true
# 登录弹窗默认打开「账号登录」（mock 只实现了手机号 + 密码登录）
SHOPRO_DEFAULT_LOGIN=accountLogin
