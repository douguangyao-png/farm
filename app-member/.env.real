# 真后端模式：部署到 https://121.40.221.126/farm-real/m/，接口走同源 /farm-real-api（nginx 反代到芋道 + farm 模块 48080）
# 构建：npm run build:h5:real（子路径由 scripts/uni.cjs 设置）；产物没有演示角标、没有 mock 地址
SHOPRO_DEV_BASE_URL=/farm-real-api
SHOPRO_BASE_URL=/farm-real-api
SHOPRO_TRIAL_BASE_URL=/farm-real-api
SHOPRO_STATIC_URL=/farm-real-api/static
SHOPRO_H5_URL=https://121.40.221.126/farm-real/m
SHOPRO_TENANT_ID=2
SHOPRO_MOCK_BADGE=false
# 登录弹窗默认打开「账号登录」（真后端只做了手机号 + 密码登录）
SHOPRO_DEFAULT_LOGIN=accountLogin
SHOPRO_DEMO_ACCOUNTS=true
