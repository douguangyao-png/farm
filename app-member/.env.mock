# 演示（mock）模式：C 端接口发到 mock-server
# 启动：npm run dev:h5:mock    构建：npm run build:h5:mock
SHOPRO_DEV_BASE_URL=http://localhost:48090
SHOPRO_BASE_URL=http://localhost:48090
SHOPRO_TRIAL_BASE_URL=http://localhost:48090
SHOPRO_STATIC_URL=http://localhost:48090/static
SHOPRO_H5_URL=http://localhost:3000
SHOPRO_TENANT_ID=2
# 显示「演示数据」角标（R-7）
SHOPRO_MOCK_BADGE=true
# 登录弹窗默认打开「账号登录」（mock 只实现了手机号 + 密码登录）
SHOPRO_DEFAULT_LOGIN=accountLogin
